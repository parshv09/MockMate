# ==============================================================================
# MockMate Environment Configuration Template
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django & Security Settings
# ------------------------------------------------------------------------------
# Set to True for local development, False for production
DEBUG=True

# Django secret key (generate a unique string for production)
SECRET_KEY=django-insecure-change-this-in-production-random-string

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# Groq LLM API Configuration
# ------------------------------------------------------------------------------
# Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Identifier (defaults to llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# RAG (Retrieval-Augmented Generation) Question Pipeline
# ------------------------------------------------------------------------------
# Master switch for RAG-based interview question generation (True/False)
# When False or disabled, MockMate uses direct Groq generation
RAG_ENABLED=False

# Number of top relevant knowledge chunks to retrieve per interview generation
RAG_TOP_K=5

# Document chunking size in characters
RAG_CHUNK_SIZE=800

# Overlap between consecutive chunks in characters (maintains context across boundaries)
RAG_CHUNK_OVERLAP=120

# Minimum cosine similarity threshold for retrieved chunks [0.0 - 1.0]
# Chunks with similarity lower than this threshold are filtered out
RAG_SIMILARITY_THRESHOLD=0.3

# ChromaDB collection name for storing indexed interview knowledge
RAG_COLLECTION_NAME=mockmate_interview_knowledge

# SentenceTransformers local embedding model identifier
# Model weights (~80MB) will be cached locally on first run
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
